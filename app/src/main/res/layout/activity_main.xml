<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calculadora de salario neto"
            android:textSize="24sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

        <EditText
            android:id="@+id/salario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Salario bruto anual"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/pagas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Número de pagas"
            android:inputType="number" />

        <EditText
            android:id="@+id/edad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Edad"
            android:inputType="number" />

        <EditText
            android:id="@+id/grupo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Grupo profesional"
            android:inputType="text" />

        <EditText
            android:id="@+id/discapacidad"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Grado de discapacidad (%)"
            android:inputType="number" />

        <EditText
            android:id="@+id/estadoCivil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Estado civil"
            android:inputType="text" />

        <EditText
            android:id="@+id/hijos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Número de hijos"
            android:inputType="number" />

        <Button
            android:id="@+id/botonCalcular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calcular salario"
            android:layout_marginTop="20dp" />

    </LinearLayout>

</ScrollView>
